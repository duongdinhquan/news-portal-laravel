APP_NAME="News Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=news_portal
DB_USERNAME=news_user
DB_PASSWORD=change_this_local_password
DB_ROOT_PASSWORD=change_this_root_password

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAX_IMAGE_SIZE_MB=5
MAX_IMAGE_PIXELS=20000000

# Leave APP_KEY and JWT_SECRET empty on first setup; Docker entrypoint generates them once.
# For non-Docker setup, run: php artisan key:generate && php artisan jwt:secret
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_PASSPHRASE=
JWT_TTL=15
JWT_REFRESH_TTL=10080
JWT_ALGO=HS256
JWT_ISSUER=news-portal
JWT_AUDIENCE=news-portal-browser
JWT_ACCESS_COOKIE=access_token
JWT_REFRESH_COOKIE=refresh_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax
JWT_LEEWAY=0
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0
JWT_DECRYPT_COOKIES=false

SEED_ADMIN_EMAIL=admin@news.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EDITOR1_EMAIL=editor1@news.local
SEED_EDITOR1_PASSWORD=Editor@12345
SEED_EDITOR2_EMAIL=editor2@news.local
SEED_EDITOR2_PASSWORD=Editor@12345
SEED_USER1_EMAIL=reader1@news.local
SEED_USER1_PASSWORD=User@12345
SEED_USER2_EMAIL=reader2@news.local
SEED_USER2_PASSWORD=User@12345
SEED_USER3_EMAIL=reader3@news.local
SEED_USER3_PASSWORD=User@12345
ALLOW_DEMO_SEED=true
